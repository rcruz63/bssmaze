# Copia a .env y rellena. NUNCA subas .env al repositorio.
# Cadena LLM: bedrock -> gemini -> offline (ADR 0006)
LLM_PROVIDER=offline                     # bedrock | gemini | offline
# Ids de modelo: siempre desde aqui, nunca en el codigo. NO verificados con la cuenta real:
# lista los ids con `uv run python -m telnet_tales.narrator.list_models`.
BEDROCK_MODEL_ID=
GEMINI_API_KEY=
GEMINI_MODEL=
AWS_REGION=                              # region con acceso a Bedrock activado
TELNET_TALES_LLM_TIMEOUT_SECONDS=8
# Estado (ADR 0009): vacio = FileStore local; con valor = DynamoDB
STATE_TABLE_NAME=
# Topes de gasto: al llegar al límite se usa el narrador offline
DAILY_LLM_CALL_CAP=500
SESSION_LLM_CALL_CAP=30
# Acceso a la terminal web pública (vacío = sin login, solo desarrollo local)
AUTH_SECRET=                             # firma HMAC del token (en AWS: SSM)
WEB_USER=
WEB_PASSWORD=
TELNET_TALES_TELNET_PORT=2323            # solo Telnet local
TELNET_TALES_BAUD_RATE=2400              # 2400 | 9600 | 0 (sin límite)
TELNET_TALES_THEME=green                 # green | amber
TELNET_TALES_LOCALE=en                   # en | es-ES
