# Copia a .env y rellena. NUNCA subas .env al repositorio.
TELNET_TALES_LLM_PROVIDER=offline        # offline | gemini
GEMINI_API_KEY=
# Id del modelo: siempre desde aqui, nunca en el codigo. Valor inicial NO verificado:
# lista los ids reales con `uv run python -m telnet_tales.narrator.list_models`.
GEMINI_MODEL=gemini-3.5-flash-lite
TELNET_TALES_LLM_TIMEOUT_SECONDS=8
# Opcional: Vertex AI con créditos de un proyecto de GCP (en vez de GEMINI_API_KEY)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Opcional: guardados en un bucket de GCS (vacio = disco local, efimero en Cloud Run)
GCS_SAVE_BUCKET=
# Topes de gasto: al llegar al límite se usa el narrador offline
TELNET_TALES_LLM_CALLS_PER_SESSION=30
TELNET_TALES_LLM_CALLS_PER_DAY=500
# Acceso a la terminal web pública (vacío = sin login, solo para desarrollo local)
TELNET_TALES_WEB_USER=
TELNET_TALES_WEB_PASSWORD=
TELNET_TALES_TELNET_PORT=2323
TELNET_TALES_WEB_PORT=8080
TELNET_TALES_BAUD_RATE=2400              # 2400 | 9600 | 0 (sin límite)
TELNET_TALES_THEME=green                 # green | amber
TELNET_TALES_LOCALE=en                   # en | es-ES
